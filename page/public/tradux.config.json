{
  "i18nPath": "./i18n",
  "defaultLanguage": "en",
  "availableLanguages": [
    "de",
    "en",
    "es",
    "fr",
    "it",
    "ja",
    "pt"
  ],
  "translation": {
    "default": {
      "provider": "openrouter",
      "model": "google/gemini-2.0-flash-001"
    },
    "fallback": {
      "provider": "openrouter",
      "model": "@google/gemini-2.0-flash-lite-001"
    }
  }
}
